---
import '../index.css';

interface Props {
  title: string;
  description?: string;
  /** URL path, e.g. "/about". Omit to derive from request URL. */
  canonicalPath?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: string;
}

const SITE_URL = 'https://komodo-consulting.pt';
const SITE_NAME = 'Komodo Consulting';
const DEFAULT_OG_IMAGE = '/og-image.png';

const {
  title,
  description = '',
  canonicalPath,
  noindex = false,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
} = Astro.props;

const pathname = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/';
const canonical = canonicalPath != null ? `${SITE_URL}${canonicalPath}` : `${SITE_URL}${pathname === '/' ? '' : pathname}`;
const isHome = pathname === '/';
const fullTitle = isHome ? title : `${title} — ${SITE_NAME}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{fullTitle}</title>

      <!-- Cookiebot CMP — must load before GTM, auto-blocking enabled -->
      <script
        id="Cookiebot"
        src="https://consent.cookiebot.com/uc.js"
        data-cbid="decb2f98-205a-499a-8238-551595294750"
        data-blockingmode="auto"
        type="text/javascript"
        async
      ></script>

      <!-- Google Consent Mode v2 — default deny; Cookiebot updates on user choice -->
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('consent', 'default', {
          'ad_storage': 'denied',
          'ad_user_data': 'denied',
          'ad_personalization': 'denied',
          'analytics_storage': 'denied',
          'functionality_storage': 'denied',
          'personalization_storage': 'denied',
          'security_storage': 'granted',
          'wait_for_update': 500
        });
      </script>

      <!-- Google Tag Manager -->
      <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-KRPLXBDR');</script>
      <!-- End Google Tag Manager -->

    <!-- JSON-LD and any extra head tags injected per-page -->
    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KRPLXBDR"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
  </body>
</html>
