---
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../App';

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://komodo-consulting.pt" },
    { "@type": "ListItem", position: 2, name: "Consulting", item: "https://komodo-consulting.pt/consulting" },
  ],
};
---

<BaseLayout
  title="Strategy & Digital Transformation Consulting"
  description="Komodo Consulting provides strategy and digital transformation consulting for companies and public entities in Portugal."
  canonicalPath="/consulting"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <App client:only="react" />
</BaseLayout>
